<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding: "your name". A badge with a person and an engraved name line.
     Decorative: set contentDescription at the call site if needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft inner disc -->
    <path
        android:fillColor="#1AAEB8C0"
        android:pathData="M12,54 A42,42 0 1,1 96,54 A42,42 0 1,1 12,54 Z" />

    <!-- Titanium ring -->
    <path
