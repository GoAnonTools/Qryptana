    <!-- Copper reflection on the upper-left edge of the ring -->
    <path
        android:strokeColor="#D9A878"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M17.6,33 A42,42 0 0,1 54,12" />

    <!-- Head -->
    <path
        android:fillColor="#C9CFD6"
        android:pathData="M42,43 A12,12 0 1,1 66,43 A12,12 0 1,1 42,43 Z" />

    <!-- Shoulders -->
    <path
        android:fillColor="#AEB8C0"
        android:pathData="M30,78 C30,64 41,58 54,58 C67,58 78,64 78,78 Z" />

    <!-- Engraved name line -->
    <path
        android:strokeColor="#C4844A"
